{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-lesson-schedule",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "personal-lesson-schedule-db",
      // npx wrangler d1 create personal-lesson-schedule-db 실행 후 나오는 id로 교체
      "database_id": "REPLACE_WITH_DATABASE_ID"
    }
  ],
  "observability": {
    "enabled": true
  }
}
